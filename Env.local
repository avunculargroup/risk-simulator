# ═══════════════════════════════════════════════════════
# BTC Treasury Risk Simulator — Environment Variables
# Copy to .env.local and fill in your values
# ═══════════════════════════════════════════════════════

# ── Supabase ──
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Database ──
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
# IMPORTANT: Use port 6543 (Transaction Mode / pgBouncer) for runtime
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres
# Use port 5432 (Session Mode) for migrations ONLY
DIRECT_DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# ── Redis (for BullMQ job queue) ──
# Use Railway, Upstash, or any Redis provider
REDIS_URL=redis://default:password@host:6379

# ── NextAuth ──
NEXTAUTH_SECRET=generate-a-random-32-char-string-here
NEXTAUTH_URL=http://localhost:3000

# ── External Data APIs ──
# CoinGecko: free tier works, API key increases rate limits
# Get from: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# FRED: free API key for macro data (Fed Funds Rate, DXY, 10Y Yield)
# Get from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage: free tier (25 requests/day) for S&P 500, Gold, VIX
# Get from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
